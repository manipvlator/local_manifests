<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <remote
        name="manipvlator"
        fetch="https://github.com/manipvlator/" />

    <!-- Device -->
    <project
        path="device/xiaomi/sweet"
        name="device_xiaomi_sweet"
        remote="manipvlator"
        revision="16" />

    <project
        path="device/xiaomi/sm6150-common"
        name="device_xiaomi_sm6150-common"
        remote="manipvlator"
        revision="16" />

    <!-- Vendor -->
    <project
        path="vendor/xiaomi/sm6150-common"
        name="vendor_xiaomi_sm6150-common"
        remote="manipvlator"
        revision="16" />

    <project
        path="vendor/xiaomi/sweet"
        name="vendor_xiaomi_sweet"
        remote="manipvlator"
        revision="stable" />

    <!-- MIUI Camera -->
    <project
        path="device/xiaomi/miuicamera-sweet"
        name="device_xiaomi_miuicamera-sweet"
        remote="manipvlator"
        revision="sweet" />

    <project
        path="vendor/xiaomi/miuicamera-sweet"
        name="vendor_xiaomi_miuicamera-sweet"
        remote="manipvlator"
        revision="leica" />

    <!-- Hardware Xiaomi -->
    <project
        path="hardware/xiaomi"
        name="hardware_xiaomi"
        remote="manipvlator"
        revision="sweet" />

    <!-- Kernel -->
    <project
        path="kernel/xiaomi/sm6150"
        name="los_kernel_xiaomi_sm6150"
        remote="manipvlator"
        revision="stable" />

    <!-- Dolby -->
    <project
        path="vendor/sony/dolby"
        name="proprietary_vendor_sony_dolby"
        remote="manipvlator"
        revision="sweet" />

    <project
        path="packages/apps/LunarisDolby"
        name="android_packages_apps_LunarisDolby"
        remote="manipvlator"
        revision="main" />

</manifest>